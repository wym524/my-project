{
  "name": "ielts-study-space",
  "version": "1.0.0",
  "description": "IELTS 学习空间 - 雅思备考桌面应用（词汇、听说读写、AI 对话、学习进度与打卡）",
  "main": "electron-main.js",
  "author": "IELTS Study Space",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "electron:server": "node server.js",
    "build": "electron-builder --win --x64",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "express": "^4.18.2",
    "better-sqlite3": "^11.3.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.ielts.studyspace",
    "productName": "IELTS Study Space",
    "copyright": "Copyright © 2025 IELTS Study Space",
    "asar": true,
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "electron-main.js",
      "server.js",
      "index.html",
      "404.svg",
      "favicon.png",
      "favicon.svg",
      "salvation_lies_within_IELTS_dark.svg",
      "salvation_lies_within_IELTS_light.svg",
      "assets/**/*",
      "179_audios/**/*",
      "grammar/**/*",
      "screenshot/**/*",
      "vocabulary/**/*"
    ],
    "extraResources": [
      {
        "from": "./server.js",
        "to": "app/server.js"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ielts-study-space-${version}-setup.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IELTS Study Space",
      "differentialPackage": false
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "category": "Education",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    }
  }
}
